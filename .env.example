# Copia questo file in .env e compila i valori.
# Le variabili VITE_* finiscono nel browser: metti lì solo chiavi pubbliche.

# ── Supabase ──
# Indirizzo e chiave pubblica sono in src/integrations/supabase/config.ts.
# Chiave segreta (Project Settings → API Keys → sb_secret_...): SOLO server, mai nel browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── AI: camera AR, consigli sensori, interventi ──
# Google Gemini (consigliato, ha un livello gratuito): chiave da https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# In alternativa OpenAI Responses API (usata solo se GEMINI_API_KEY è vuota)
OPENAI_API_KEY=
# Facoltativi
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Maps ──
# Chiave server: Geocoding API + Places API (New), senza restrizione referrer
GOOGLE_MAPS_API_KEY=
# Chiave browser: Maps Embed API, limitata al dominio del sito (facoltativa: senza usa OpenStreetMap)
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ── Ricerca giornaliera delle fonti dei casi studio (parallel.ai) ──
PARALLEL_API_KEY=

# ── Job pianificati: segreto per POST /api/public/jobs/case-sources ──
CRON_SECRET=
