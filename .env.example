# Copia questo file in .env e compila i valori.
# Le variabili VITE_* finiscono nel browser: metti lì solo chiavi pubbliche.

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Stessi valori, letti dal server
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chiave segreta (sb_secret_... o service_role): SOLO server, mai nel browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── AI: camera AR, consigli sensori, interventi (OpenAI Responses API) ──
OPENAI_API_KEY=
# Facoltativi
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Maps ──
# Chiave server: Geocoding API + Places API (New), senza restrizione referrer
GOOGLE_MAPS_API_KEY=
# Chiave browser: Maps Embed API, limitata al dominio del sito (facoltativa: senza usa OpenStreetMap)
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ── Ricerca giornaliera delle fonti dei casi studio (parallel.ai) ──
PARALLEL_API_KEY=

# ── Job pianificati: segreto per POST /api/public/jobs/case-sources ──
CRON_SECRET=
